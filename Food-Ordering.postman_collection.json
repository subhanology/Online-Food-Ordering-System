{
  "info": {
    "name": "Q1 Food Ordering",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Get food",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/food",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"03001234567\",\n  \"address\": \"Islamabad\",\n  \"items\": [\n    {\n      \"id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"id\": 3,\n      \"quantity\": 1\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Total is 1150\", function () { pm.expect(pm.response.json().total).to.eql(1150); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/orders",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject empty cart",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"03001234567\",\n  \"address\": \"Islamabad\",\n  \"items\": []\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid food",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"03001234567\",\n  \"address\": \"Islamabad\",\n  \"items\": [\n    {\n      \"id\": 999,\n      \"quantity\": 1\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid phone",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ali Khan\",\n  \"phone\": \"123\",\n  \"address\": \"Islamabad\",\n  \"items\": [\n    {\n      \"id\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"id\": 3,\n      \"quantity\": 1\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}